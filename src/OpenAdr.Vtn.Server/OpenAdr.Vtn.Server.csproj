<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpenAdr.Vtn.Core\OpenAdr.Vtn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      wwwroot/ is plain static files served by UseStaticFiles/UseDefaultFiles at runtime and
      copied to the publish output by IncludeDashboardInPublish below — none of the SDK's
      Static Web Assets features (bundling, fingerprinting, Razor component integration) are
      used. Its incremental manifest in obj/ gets out of sync with Vite's content-hashed
      output filenames (a different hash every time dashboard source changes) and fails the
      build with a stale "No file exists for the asset" error; disabling it entirely avoids
      that whole class of problem rather than working around it build-by-build.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!--
    Tuned for the 512 MB Lightsail Nano bundle: workstation (non-server) GC, no background
    concurrent GC thread, and a 256 MB heap hard limit (runtimeconfig.template.json) — leaving
    headroom for the MQTT broker, Kestrel, SQLite, and the OS itself. Override the hard limit
    at runtime without rebuilding via the DOTNET_GCHeapHardLimit env var (hex bytes).
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    The dashboard (dashboard/) is React/Vite/TS source, not .NET — it is built here so that
    `dotnet run` and `dotnet publish` always embed a fresh wwwroot/ without a separate manual
    step, on this machine only ("build on my machine, never on the server" for the Lightsail
    deploy). Inputs/Outputs make this incremental: npm only runs again when dashboard source
    actually changed, so a plain C# edit-and-run stays fast.
  -->
  <PropertyGroup>
    <DashboardDir>$(MSBuildProjectDirectory)/../../dashboard</DashboardDir>
  </PropertyGroup>

  <ItemGroup>
    <DashboardSource Include="$(DashboardDir)/src/**/*.*" />
    <DashboardSource Include="$(DashboardDir)/index.html" />
    <DashboardSource Include="$(DashboardDir)/package.json" />
    <DashboardSource Include="$(DashboardDir)/package-lock.json" />
    <DashboardSource Include="$(DashboardDir)/vite.config.ts" />
    <DashboardSource Include="$(DashboardDir)/tsconfig*.json" />
  </ItemGroup>

  <Target Name="BuildDashboard" BeforeTargets="BeforeBuild;AssignTargetPaths"
          Inputs="@(DashboardSource)"
          Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html">
    <Exec Command="npm install" WorkingDirectory="$(DashboardDir)" Condition="!Exists('$(DashboardDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(DashboardDir)" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot" Condition="Exists('$(MSBuildProjectDirectory)/wwwroot')" />
    <ItemGroup>
      <DashboardDist Include="$(DashboardDir)/dist/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DashboardDist)" DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)" />
  </Target>

  <!--
    The app's ContentRootPath is anchored to its own executable directory (see Program.cs),
    not the caller's working directory — so wwwroot/ must actually be copied next to the
    executable (both the build output AND the publish output), not just live in the project's
    source tree. wwwroot/ is created by the target above, which runs after the SDK's own
    item-discovery has already evaluated an empty folder on a clean checkout, so the files are
    registered explicitly here (BeforeTargets="AssignTargetPaths", the standard hook for
    dynamically-generated Content items) rather than via the SDK's implicit wwwroot glob.
  -->
  <Target Name="IncludeDashboardOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildDashboard">
    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)/wwwroot/**/*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
