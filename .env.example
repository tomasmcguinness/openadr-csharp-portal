# Copy to .env (docker compose reads it automatically) and adjust as needed.

# Host port `vtn` is published on — change if 8080 is already taken on this machine.
VTN_PORT=8080

# Whether the in-process MQTT broker runs inside the container (see README
# "Configuration"). Most setups don't need this on — VENs just poll instead of subscribing.
VTN_MQTT_ENABLED=false

# Not read by docker-compose.yml here — it's the domain var the *external* Caddy instance
# (see Caddyfile, README "Run with Docker") uses to front this VTN. Listed here only so
# everything this stack needs is documented in one place; set it on the Caddy host instead.
VTN_DOMAIN=
