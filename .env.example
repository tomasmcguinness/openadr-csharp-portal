# Copy to .env (docker compose reads it automatically) and adjust as needed.

# Host port `vtn` is published on — change if 8080 is already taken on this machine.
VTN_PORT=8080

# Whether the in-process MQTT broker runs inside the container (see README
# "Configuration"). Most setups don't need this on — VENs just poll instead of subscribing.
VTN_MQTT_ENABLED=false

# The domain this VTN is served under. Not read by docker-compose.yml itself, but used by
# whichever Caddy fronts it: either the root Caddyfile (a block to paste into an existing,
# *external* Caddy instance) or docker-compose.caddy.yml (a Caddy bundled into this stack —
# required there, see that file). See README "Run with Docker" for both options.
VTN_DOMAIN=
