# Used by docker-compose.caddy.yml: a Caddy bundled into this project's own stack, for when
# fronting the VTN from an existing/external Caddy instance (see the root Caddyfile) isn't
# practical. Self-contained — reverse-proxies over this project's own Docker network, so it
# needs nothing from any other service.
{$VTN_DOMAIN} {
	tls {
		# RSA, not Caddy's default ECDSA: the ESP32-S3 HEMS has no ECC accelerator,
		# and an ECDSA handshake in software is slow enough to time out.
		key_type rsa2048
	}

	encode gzip
	reverse_proxy vtn:8080
}
